TRIP_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
# Beijing region. You can substitute the workspace-specific base URL from Bailian.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Opt in to storing prompts, user notes and raw successful responses locally.
RECORD_LLM_EXPERIMENTS=false

# Open-Meteo daily forecast (no key needed); failures do not block trips.
WEATHER_ENABLED=true
